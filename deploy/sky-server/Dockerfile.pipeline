FROM ubuntu:26.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git ca-certificates && rm -rf /var/lib/apt/lists/* && python3 -m venv /venv && /venv/bin/pip install --no-cache-dir pillow yt-dlp
ENV PATH="/venv/bin:$PATH" TZ=Asia/Taipei
WORKDIR /app
CMD ["python", "scripts/run_pipeline.py", "--publish-local"]
